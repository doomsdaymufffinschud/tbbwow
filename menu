CreateBtn("FIRE", "FIRE", UDim2.new(1, -210, 1, -210), UDim2.new(0, 80, 0, 80), Color3.new(0.8, 0, 0), "FIRE")

-- JOYSTICK DI CHUYỂN BÊN TRÁI
local JoystickFrame = Instance.new("Frame", Gui)
JoystickFrame.Name = "StableMobileControls"
JoystickFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
JoystickFrame.BackgroundTransparency = 0.7
JoystickFrame.Position = UDim2.new(0, 60, 1, -220)
JoystickFrame.Size = UDim2.new(0, 150, 0, 150)
JoystickFrame.ZIndex = 500
JoystickFrame.Active = true
Instance.new("UICorner", JoystickFrame).CornerRadius = UDim.new(1, 0)

local Stick = Instance.new("Frame", JoystickFrame)
Stick.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
Stick.Position = UDim2.new(0.25, 0, 0.25, 0)
Stick.Size = UDim2.new(0.5, 0, 0.5, 0)
Stick.ZIndex = 510
Instance.new("UICorner", Stick).CornerRadius = UDim.new(1, 0)

local moveVector = Vector3.new(0, 0, 0)
local activeTouch = nil

JoystickFrame.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.Touch || input.UserInputType == Enum.UserInputType.MouseButton1) and not activeTouch then
        activeTouch = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == activeTouch then
        local center = JoystickFrame.AbsolutePosition + (JoystickFrame.AbsoluteSize / 2)
        local inputPos = Vector2.new(input.Position.X, input.Position.Y)
        local diff = inputPos - center
        local dist = math.min(diff.Magnitude, 75)
        local angle = math.atan2(diff.Y, diff.X)
        
        Stick.Position = UDim2.new(0, (math.cos(angle) * dist) + (JoystickFrame.AbsoluteSize.X/4), 0, (math.sin(angle) * dist) + (JoystickFrame.AbsoluteSize.Y/4))
        
        local dirX = math.cos(angle) * (dist/75)
        local dirY = math.sin(angle) * (dist/75)
        moveVector = Vector3.new(dirX, 0, dirY)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == activeTouch then
        activeTouch = nil
        Stick.Position = UDim2.new(0.25, 0, 0.25, 0)
        moveVector = Vector3.new(0, 0, 0)
    end
end)

-- SIÊU QUÉT CHẶN VÀ TIÊU DIỆT NÚT GỐC (CHẠY LIÊN TỤC 24/7 ĐỂ CHỐNG HỒI SINH NÚT RÁC)
task.spawn(function()
    while true do
        task.wait(0.1) -- Quét cực nhanh 0.1 giây một lần để bắt ngay khi game vừa tạo lại nút
        pcall(function()
            for _, gui in pairs(LP.PlayerGui:GetChildren()) do
                if gui ~= Gui and gui:IsA("ScreenGui") then
                    for _, desc in pairs(gui:GetDescendants()) do
                        if desc:IsA("GuiObject") then
                            local text = (desc:IsA("TextButton") and desc.Text or ""):lower()
                            local name = desc.Name:lower()
                            -- Khóa mọi nút liên quan đến attack/m1/micro h.i.d ngay lập tức
                            if text:find("attack") or text:find("m1") or name:find("attack") or name:find("m1") or name:find("micro") or name:find("touchgui") then
                                desc.Visible = false
                                desc.Active = false
                                desc.Size = UDim2.new(0, 0, 0, 0) -- Thu nhỏ kích thước về 0 để không cản trở cảm ứng xoay màn hình
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- VÒNG LẶP ĐIỀU KHIỂN NHÂN VẬT
RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    local char = LP.Character
    
    if char and char:FindFirstChild("Humanoid") and moveVector.Magnitude > 0 then
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        look = Vector3.new(look.X, 0, look.Z).Unit
        right = Vector3.new(right.X, 0, right.Z).Unit
        local finalDir = (look * -moveVector.Z) + (right * moveVector.X)
        char.Humanoid:Move(finalDir, false)
    end
end)
 
