-- TÂM ĐỎ ĐỊNH VỊ
local Cross = Instance.new("Frame", Gui)
Cross.Size = UDim2.new(0, 6, 0, 6)
Cross.Position = UDim2.new(0.5, -3 + Offset_X, 0.5, -3)
Cross.BackgroundColor3 = Color3.new(1, 0, 0)
Cross.BorderSizePixel = 0
Cross.ZIndex = 1000
Instance.new("UICorner", Cross).CornerRadius = UDim.new(1, 0)

local isFiring = false 

-- HỆ THỐNG NÚT BẤM CHIẾN ĐẤU CỐ ĐỊNH (FIX FIRE DÙNG ĐƯỢC CHUẨN 100%)
local function CreateBtn(name, txt, pos, sz, color, action)
    local b = Instance.new("TextButton", Gui)
    b.Name = name; b.Text = txt; b.Position = pos; b.Size = sz
    b.BackgroundColor3 = color; b.BackgroundTransparency = 0.4
    b.TextColor3 = Color3.new(1,1,1); b.TextSize = 22; b.ZIndex = 500
    b.Font = Enum.Font.SourceSansBold; b.TextWrapped = true
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    
    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            b.BackgroundTransparency = 0.1
            if action == "FIRE" then 
                isFiring = true
                task.spawn(function()
                    local cam = workspace.CurrentCamera
                    local centerX = cam.ViewportSize.X / 2 + Offset_X
                    local centerY = cam.ViewportSize.Y / 2
                    
                    -- Gửi sự kiện nhấn giữ liên tục chuẩn xác tại tâm
                    while isFiring do
                        VIM:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
                        task.wait(0.05)
                        VIM:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
                        task.wait(0.05)
                    end
                end)
            elseif action == "JUMP" then
                VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            else
                VIM:SendKeyEvent(true, action, false, game)
            end
        end
    end)
    
    b.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            b.BackgroundTransparency = 0.4
            if action == "FIRE" then 
                isFiring = false
            elseif action == "JUMP" then
                VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            else
                VIM:SendKeyEvent(false, action, false, game)
            end
        end
    end)
end

CreateBtn("Q", "Q", UDim2.new(1, -95, 1, -210), UDim2.new(0, 65, 0, 65), Color3.fromRGB(255, 150, 0), Enum.KeyCode.Q)
CreateBtn("E", "E", UDim2.new(1, -180, 1, -120), UDim2.new(0, 65, 0, 65), Color3.fromRGB(0, 120, 255), Enum.KeyCode.E)
