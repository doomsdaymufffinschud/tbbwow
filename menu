 -- MOBILE COMBAT V51 - THE BATTLE BRICKS (STABLE & SAFE MODE)
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer

local Offset_X = 30  

-- Reset UI cũ tránh trùng lặp
local old = LP.PlayerGui:FindFirstChild("CombatV51")
if old then old:Destroy() end

local Gui = Instance.new("ScreenGui", LP.PlayerGui)
Gui.Name = "CombatV51"
Gui.ResetOnSpawn = false
Gui.IgnoreGuiInset = true
Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- TÂM ĐỎ ĐỊNH VỊ
local Cross = Instance.new("Frame", Gui)
Cross.Size = UDim2.new(0, 6, 0, 6)
Cross.Position = UDim2.new(0.5, -3 + Offset_X, 0.5, -3)
Cross.BackgroundColor3 = Color3.new(1, 0, 0)
Cross.BorderSizePixel = 0
Cross.ZIndex = 1000
Instance.new("UICorner", Cross).CornerRadius = UDim.new(1, 0)

local isFiring = false 

-- HỆ THỐNG NÚT BẤM CHIẾN ĐẤU CỐ ĐỊNH (AN TOÀN CHO MỌI EXECUTOR)
local function CreateBtn(name, txt, pos, sz, color, action)
    local b = Instance.new("TextButton", Gui)
    b.Name = name; b.Text = txt; b.Position = pos; b.Size = sz
    b.BackgroundColor3 = color; b.BackgroundTransparency = 0.4
    b.TextColor3 = Color3.new(1,1,1); b.TextSize = 22; b.ZIndex = 500
    b.Font = Enum.Font.SourceSansBold; b.TextWrapped = true
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    
    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            b.BackgroundTransparency = 0.1
            if action == "FIRE" then 
                isFiring = true
                task.spawn(function()
                    while isFiring do
                        local cam = workspace.CurrentCamera
                        local centerX = cam.ViewportSize.X / 2 + Offset_X
                        local centerY = cam.ViewportSize.Y / 2
                        pcall(function()
                            VIM:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
                        end)
                        task.wait(0.05)
                        pcall(function()
                            VIM:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
                        end)
                        task.wait(0.05)
                    end
                end)
            elseif action == "JUMP" then
                pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game) end)
            else
                pcall(function() VIM:SendKeyEvent(true, action, false, game) end)
            end
        end
    end)
    
    b.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            b.BackgroundTransparency = 0.4
            if action == "FIRE" then 
                isFiring = false
            elseif action == "JUMP" then
                pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
            else
                pcall(function() VIM:SendKeyEvent(false, action, false, game) end)
            end
        end
    end)
end

CreateBtn("Q", "Q", UDim2.new(1, -95, 1, -210), UDim2.new(0, 65, 0, 65), Color3.fromRGB(255, 150, 0), Enum.KeyCode.Q)
CreateBtn("E", "E", UDim2.new(1, -180, 1, -120), UDim2.new(0, 65, 0, 65), Color3.fromRGB(0, 120, 255), Enum.KeyCode.E)
CreateBtn("G", "G", UDim2.new(1, -95, 1, -285), UDim2.new(0, 65, 0, 65), Color3.fromRGB(0, 200, 100), Enum.KeyCode.G) 
CreateBtn("JUMP", "JUMP", UDim2.new(1, -120, 1, -145), UDim2.new(0, 90, 0, 90), Color3.fromRGB(80, 80, 80), "JUMP")
CreateBtn("FIRE", "FIRE", UDim2.new(1, -210, 1, -210), UDim2.new(0, 80, 0, 80), Color3.new(0.8, 0, 0), "FIRE")

-- JOYSTICK DI CHUYỂN BÊN TRÁI
local JoystickFrame = Instance.new("Frame", Gui)
JoystickFrame.Name = "StableMobileControls"
JoystickFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
JoystickFrame.BackgroundTransparency = 0.7
JoystickFrame.Position = UDim2.new(0, 60, 1, -220)
JoystickFrame.Size = UDim2.new(0, 150, 0, 150)
JoystickFrame.ZIndex = 500
JoystickFrame.Active = true
Instance.new("UICorner", JoystickFrame).CornerRadius = UDim.new(1, 0)

local Stick = Instance.new("Frame", JoystickFrame)
Stick.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
Stick.Position = UDim2.new(0.25, 0, 0.25, 0)
Stick.Size = UDim2.new(0.5, 0, 0.5, 0)
Stick.ZIndex = 510
Instance.new("UICorner", Stick).CornerRadius = UDim.new(1, 0)

local moveVector = Vector3.new(0, 0, 0)
local activeTouch = nil

JoystickFrame.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not activeTouch then
        activeTouch = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == activeTouch then
        local center = JoystickFrame.AbsolutePosition + (JoystickFrame.AbsoluteSize / 2)
        local inputPos = Vector2.new(input.Position.X, input.Position.Y)
        local diff = inputPos - center
        local dist = math.min(diff.Magnitude, 75)
        local angle = math.atan2(diff.Y, diff.X)
        
        Stick.Position = UDim2.new(0, (math.cos(angle) * dist) + (JoystickFrame.AbsoluteSize.X/4), 0, (math.sin(angle) * dist) + (JoystickFrame.AbsoluteSize.Y/4))
        
        local dirX = math.cos(angle) * (dist/75)
        local dirY = math.sin(angle) * (dist/75)
        moveVector = Vector3.new(dirX, 0, dirY)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == activeTouch then
        activeTouch = nil
        Stick.Position = UDim2.new(0.25, 0, 0.25, 0)
        moveVector = Vector3.new(0, 0, 0)
    end
end)

-- VÒNG LẶP ĐIỀU KHIỂN NHÂN VẬT MƯỢT MÀ
RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    local char = LP.Character
    
    if char and char:FindFirstChild("Humanoid") and moveVector.Magnitude > 0 then
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        look = Vector3.new(look.X, 0, look.Z).Unit
        right = Vector3.new(right.X, 0, right.Z).Unit
        local finalDir = (look * -moveVector.Z) + (right * moveVector.X)
        char.Humanoid:Move(finalDir, false)
    end
end)

print("Combat V51 Loaded Successfully!")
